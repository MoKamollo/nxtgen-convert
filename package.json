{
  "name": "nxtgen-convert",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "test": "node --experimental-strip-types --test tests/foundation.test.ts tests/migrations.test.mjs tests/security-static.test.mjs",
    "secrets:migrate:dry": "node scripts/migrate-legacy-secrets.mjs",
    "secrets:migrate": "node scripts/migrate-legacy-secrets.mjs --apply",
    "test:security": "node --test tests/security-static.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "db:migrate:dry": "node scripts/apply-migrations.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs --apply",
    "db:rollback": "node scripts/rollback-migration.mjs",
    "backfill:identities": "node scripts/backfill-contact-identities.mjs",
    "check:syntax": "node scripts/check-typescript-syntax.cjs",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "groq-sdk": "^1.3.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.9.2",
    "resend": "^6.18.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.3"
  }
}
